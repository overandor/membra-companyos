#!/usr/bin/env python3
"""
Windsurf Self-Optimizer
A macOS menu bar app that decompresses RAM, CPU, and GPU,
and optimizes the Windsurf IDE for peak performance.
"""

import os
import sys
import subprocess
import time
import shutil
import platform
from pathlib import Path

import rumps
import psutil

APP_NAME = "Windsurf Optimizer"
ICON_DISK = "💿"
ICON_SPINNER = "🌀"
ICON_CHECK = "✅"

WINDSURF_PROCESS_NAMES = [
    "Windsurf",
    "windsurf",
    "Code Helper",
    "Code-Helper",
    "Electron",
    "windsurf Helper",
]


class WindsurfOptimizer(rumps.App):
    def __init__(self):
        super().__init__(
            name=APP_NAME,
            title=ICON_DISK,
            quit_button="Quit"
        )

        self.last_optimization_time = None
        self.optimization_count = 0

        # Build dynamic menu
        self.menu = [
            rumps.MenuItem("Status", callback=None),
            None,  # separator
            rumps.MenuItem("🌀 Full System Optimize", callback=self.full_optimize),
            rumps.MenuItem("🧠 Decompress RAM", callback=self.decompress_ram),
            rumps.MenuItem("⚡ Decompress CPU", callback=self.decompress_cpu),
            rumps.MenuItem("🎮 Decompress GPU", callback=self.decompress_gpu),
            rumps.MenuItem("🌊 Optimize Windsurf", callback=self.optimize_windsurf),
            None,  # separator
            rumps.MenuItem("📊 Refresh Stats", callback=self.refresh_stats),
            rumps.MenuItem("🔔 Auto-Optimize Every 5m", callback=self.toggle_auto),
        ]

        self.auto_optimize_enabled = False
        self.auto_timer = None

        # Initial stats update
        self.refresh_stats(None)

    # ------------------------------------------------------------------
    # System info helpers
    # ------------------------------------------------------------------
    def _get_ram_info(self):
        vm = psutil.virtual_memory()
        return {
            "percent": vm.percent,
            "used_gb": round(vm.used / (1024 ** 3), 2),
            "total_gb": round(vm.total / (1024 ** 3), 2),
            "available_gb": round(vm.available / (1024 ** 3), 2),
        }

    def _get_cpu_info(self):
        return {
            "percent": psutil.cpu_percent(interval=0.5),
            "cores": psutil.cpu_count(logical=True),
        }

    def _get_gpu_info(self):
        vm = psutil.virtual_memory()
        return {"memory_pressure": vm.percent}

    def _is_apple_silicon(self):
        """Detect Apple Silicon (M1/M2/M3/M4/M5)."""
        try:
            proc = subprocess.run(
                ["sysctl", "-n", "hw.optional.arm64"],
                capture_output=True, text=True, timeout=2
            )
            return proc.stdout.strip() == "1"
        except Exception:
            return False

    def _get_chip_name(self):
        """Return the Apple Silicon chip name, or empty string."""
        try:
            proc = subprocess.run(
                ["sysctl", "-n", "machdep.cpu.brand_string"],
                capture_output=True, text=True, timeout=2
            )
            return proc.stdout.strip()
        except Exception:
            return ""

    def _run(self, cmd, shell=True, sudo=False):
        """Run a shell command; return (ok, stdout_or_error)."""
        try:
            if sudo:
                cmd = f"osascript -e 'do shell script \"{cmd}\" with administrator privileges'"
            result = subprocess.run(
                cmd,
                shell=shell,
                capture_output=True,
                text=True,
                timeout=30,
            )
            return result.returncode == 0, result.stdout.strip()
        except Exception as e:
            return False, str(e)

    # ------------------------------------------------------------------
    # Menu callbacks
    # ------------------------------------------------------------------
    def refresh_stats(self, sender):
        ram = self._get_ram_info()
        cpu = self._get_cpu_info()
        gpu = self._get_gpu_info()

        status_lines = [
            f"🧠  RAM: {ram['percent']}% ({ram['used_gb']}/{ram['total_gb']} GB)",
            f"⚡  CPU: {cpu['percent']}% ({cpu['cores']} cores)",
            f"🎮  GPU/VRAM Pressure: {gpu['memory_pressure']}%",
        ]

        if self.last_optimization_time:
            ago = int(time.time() - self.last_optimization_time)
            status_lines.append(f"🕐  Last optimized: {ago}s ago")
            status_lines.append(f"🔁  Optimizations: {self.optimization_count}")

        # Update the first menu item in-place
        for item in self.menu:
            if isinstance(item, rumps.MenuItem) and item.title.startswith("Status"):
                item.title = "\n".join(status_lines)
                break

        return status_lines

    def decompress_ram(self, sender):
        self.title = ICON_SPINNER
        rumps.notification(
            title=APP_NAME,
            subtitle="Decompressing RAM…",
            message="Fast Apple Silicon purge + cache flush",
            sound=None,
        )

        results = []
        is_as = self._is_apple_silicon()
        chip = self._get_chip_name()
        if chip:
            results.append(f"Detected: {chip}")

        # 1. Fast purge — on Apple Silicon this flushes inactive to the compressor
        ok, out = self._run("purge", sudo=True)
        results.append(f"purge: {'OK' if ok else out}")

        # 2. Apple Silicon fast-path: trigger memory-pressure relief via sysctl
        if is_as:
            self._run("sysctl -w vm.page_free_wanted=16384 >/dev/null 2>&1", sudo=True)
            results.append("AS memory reclaim triggered")

        # 3. Drop DNS / directory service caches
        self._run("dscacheutil -flushcache; killall -HUP mDNSResponder", sudo=True)
        results.append("DNS cache flushed")

        # 4. Clear stale user caches (aggressive but safe: files older than 5 min)
        cache_dirs = [
            Path.home() / "Library" / "Caches",
            Path.home() / "Library" / "Caches" / "com.apple.WebKit.Networking",
            Path.home() / "Library" / "Caches" / "com.apple.Safari",
        ]
        cutoff = time.time() - 300
        for cdir in cache_dirs:
            if not cdir.exists():
                continue
            for f in cdir.rglob("*"):
                try:
                    if f.is_file() and f.stat().st_atime < cutoff:
                        f.unlink()
                except Exception:
                    pass
        results.append("stale caches cleared")

        # 5. Force Python / psutil to garbage collect
        import gc
        gc.collect()
        results.append("GC done")

        self._finish_optimize(results, "RAM Decompressed")

    def decompress_cpu(self, sender):
        self.title = ICON_SPINNER
        rumps.notification(
            title=APP_NAME,
            subtitle="Decompressing CPU…",
            message="Fast AS renice + background throttling",
            sound=None,
        )

        results = []
        is_as = self._is_apple_silicon()

        # 1. Fast single-pass process scan for Windsurf + heavy helpers
        windsurf_pids = []
        heavy_helpers = []
        for proc in psutil.process_iter(["pid", "name", "cpu_percent", "create_time"]):
            try:
                name = proc.info["name"] or ""
                pid = proc.info["pid"]
                if any(target in name for target in WINDSURF_PROCESS_NAMES):
                    windsurf_pids.append((pid, name))
                elif is_as and "Helper" in name and any(w in name for w in ["Windsurf", "Code", "Electron"]):
                    cpu = proc.info["cpu_percent"] or 0
                    create = proc.info["create_time"] or time.time()
                    if cpu > 50 and (time.time() - create) > 120:
                        heavy_helpers.append((pid, name))
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                pass

        # 2. Aggressive renice for Windsurf processes (-10 = high priority)
        for pid, name in windsurf_pids:
            os.system(f"renice -n -10 -p {pid} >/dev/null 2>&1")
            results.append(f"boosted {name}({pid})")

        # 3. Apple Silicon fast-path: taskpolicy background helpers
        if is_as:
            for pid, name in heavy_helpers:
                os.system(f"taskpolicy -b -p {pid} >/dev/null 2>&1")
                results.append(f"throttled {name}({pid})")

        # 4. Force App Nap off for Windsurf via defaults
        self._run(
            "defaults write com.exafunction.windsurf NSAppSleepDisabled -bool true",
            sudo=False,
        )
        results.append("App Nap disabled for Windsurf")

        # 5. Disable Spotlight indexing temporarily to free CPU
        self._run("mdutil -a -i off >/dev/null 2>&1", sudo=True)
        results.append("Spotlight indexing paused")

        self._finish_optimize(results, "CPU Decompressed")

    def decompress_gpu(self, sender):
        self.title = ICON_SPINNER
        rumps.notification(
            title=APP_NAME,
            subtitle="Decompressing GPU…",
            message="Clearing GPU caches and graphics buffers",
            sound=None,
        )

        results = []

        # On macOS the GPU is unified memory; the best we can do:
        # 1. Restart WindowServer-lite caches by pinging the graphics stack
        #    (We can't kill WindowServer without logout, but we can flush CoreAnimation)
        ok, _ = self._run(
            "qlmanage -r >/dev/null 2>&1; qlmanage -r cache >/dev/null 2>&1",
            sudo=False,
        )
        results.append("QuickLook cache flushed")

        # 2. Flush fontd / atmuserd caches (impacts GPU text rendering)
        self._run("atsutil databases -removeUser", sudo=False)
        results.append("font cache flushed")

        # 3. Clear CoreAnimation cached assets
        ca_cache = Path.home() / "Library" / "Caches" / "com.apple.coreanimation"
        if ca_cache.exists():
            shutil.rmtree(ca_cache, ignore_errors=True)
            results.append("CoreAnimation cache cleared")

        # 4. Free as much as we can via purge again
        self._run("purge", sudo=True)
        results.append("memory pressure relieved")

        self._finish_optimize(results, "GPU Decompressed")

    def optimize_windsurf(self, sender):
        self.title = ICON_SPINNER
        rumps.notification(
            title=APP_NAME,
            subtitle="Optimizing Windsurf…",
            message="Fast cache clear + AS boost",
            sound=None,
        )

        results = []
        is_as = self._is_apple_silicon()

        # 1. Fast cache wipe for Windsurf
        ws_cache_dirs = [
            Path.home() / "Library" / "Application Support" / "Windsurf" / "Cache",
            Path.home() / "Library" / "Application Support" / "Windsurf" / "CachedData",
            Path.home() / "Library" / "Application Support" / "Windsurf" / "Code Cache",
            Path.home() / "Library" / "Application Support" / "Windsurf" / "GPUCache",
            Path.home() / "Library" / "Caches" / "Windsurf",
            Path.home() / "Library" / "Application Support" / "Windsurf" / "CachedExtensionVSIXs",
        ]
        for cdir in ws_cache_dirs:
            if cdir.exists():
                shutil.rmtree(cdir, ignore_errors=True)
                results.append(f"cleared {cdir.name}")

        # 2. Single-pass boost for Windsurf processes
        for proc in psutil.process_iter(["pid", "name"]):
            try:
                name = proc.info["name"] or ""
                if any(target in name for target in WINDSURF_PROCESS_NAMES):
                    pid = proc.info["pid"]
                    os.system(f"renice -n -10 -p {pid} >/dev/null 2>&1")
                    if is_as:
                        os.system(f"taskpolicy -d user_interactive -p {pid} >/dev/null 2>&1")
                    results.append(f"boosted {name}({pid})")
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                pass

        # 3. Disable excessive logging / telemetry via defaults
        self._run(
            'defaults write com.exafunction.windsurf "crashes.reportUnhandledExceptions" -bool false',
            sudo=False,
        )
        results.append("telemetry disabled")

        self._finish_optimize(results, "Windsurf Optimized")

    def full_optimize(self, sender):
        self.title = ICON_SPINNER
        rumps.notification(
            title=APP_NAME,
            subtitle="Full System Optimize…",
            message="Running full RAM, CPU, GPU and Windsurf optimization",
            sound=None,
        )

        self.decompress_ram(None)
        self.decompress_cpu(None)
        self.decompress_gpu(None)
        self.optimize_windsurf(None)

        self._finish_optimize(["Full cycle complete"], "System Fully Optimized")

    # ------------------------------------------------------------------
    # Helpers
    # ------------------------------------------------------------------
    def _finish_optimize(self, log_lines, notification_msg):
        self.optimization_count += 1
        self.last_optimization_time = time.time()
        self.refresh_stats(None)
        self.title = ICON_DISK
        rumps.notification(
            title=APP_NAME,
            subtitle=notification_msg,
            message="\n".join(log_lines[-3:]),  # last 3 actions
            sound=None,
        )

    def toggle_auto(self, sender):
        self.auto_optimize_enabled = not self.auto_optimize_enabled
        sender.state = self.auto_optimize_enabled
        if self.auto_optimize_enabled:
            self.auto_timer = rumps.Timer(self.full_optimize, 300)
            self.auto_timer.start()
            rumps.notification(
                title=APP_NAME,
                subtitle="Auto-Optimize Enabled",
                message="Will optimize every 5 minutes",
                sound=None,
            )
        else:
            if self.auto_timer:
                self.auto_timer.stop()
            rumps.notification(
                title=APP_NAME,
                subtitle="Auto-Optimize Disabled",
                message="Manual mode",
                sound=None,
            )


if __name__ == "__main__":
    # Ensure we can ask for admin privileges via AppleScript later
    WindsurfOptimizer().run()
