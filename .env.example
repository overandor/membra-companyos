# MEMBRA CompanyOS — Environment Template
# Copy to .env and fill in your values.

APP_NAME="MEMBRA CompanyOS"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# Security (min 32 chars)
SECRET_KEY=change-me-in-production-to-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/membracos
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/membracos

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM Providers (optional — deterministic fallback works without keys)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# Settlement / Blockchain (optional)
SOLANA_RPC_URL=
ETHEREUM_RPC_URL=
SETTLEMENT_WEBHOOK_URL=

# IPFS / ProofBook (optional)
PINATA_API_KEY=
PINATA_SECRET=

# Rate Limiting
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_API=100/minute

# CORS
CORS_ORIGINS=*

# Governance
ADMIN_WALLETS=
REQUIRE_GOVERNANCE_APPROVAL=true
